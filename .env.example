APP_ENVIRONMENT=local
APP_DEBUG=false
APP_HOST=0.0.0.0
APP_PORT=8000
APP_LOG_LEVEL=INFO
APP_DATABASE_URL=postgresql+asyncpg://tender:tender@localhost:5432/tender_intelligence
APP_DATABASE_ECHO=false
APP_DATABASE_POOL_SIZE=5
APP_DATABASE_POOL_TIMEOUT=30
APP_DATABASE_CONNECT_TIMEOUT=5
APP_STORAGE_PATH=storage/uploads
APP_UPLOAD_MAX_SIZE_MB=25
APP_UPLOAD_CHUNK_SIZE_BYTES=1048576
APP_TEXT_CHUNK_SIZE_CHARS=1200
APP_TEXT_CHUNK_OVERLAP_CHARS=200
APP_ANALYSIS_CONTEXT_MAX_CHUNKS=12
APP_ANALYSIS_CONTEXT_MAX_CHARS=16000
APP_LLM_PROVIDER=openai
APP_LLM_BASE_URL=https://api.openai.com/v1
APP_LLM_API_KEY=
APP_LLM_MODEL=gpt-4o-mini
APP_LLM_TIMEOUT_SECONDS=60
APP_EMBEDDING_MODEL=text-embedding-3-small
APP_EMBEDDING_BATCH_SIZE=32
APP_RAG_TOP_K=5
APP_HTTP_PORT=8000
POSTGRES_DB=tender_intelligence
POSTGRES_USER=tender
POSTGRES_PASSWORD=tender
